@using SiemensIXBlazor.Enums.DatePicker
@using SiemensIXBlazor.Helpers
@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-date-picker @attributes="UserAttributes"
                id="@Id"
                from="@From"
                to="@To"
                corners="@(EnumParser<DatePickerCorners>.EnumToString(Corners))"
                format="@Format"
                max-date="@MaxDate"
                min-date="@MinDate"
                single-selection="@(SingleSelection ? "true" : null)"
                aria-label-next-month-button="@AriaLabelNextMonthButton"
                aria-label-previous-month-button="@AriaLabelPreviousMonthButton"
                aria-label-month-selection="@AriaLabelMonthSelection"
                aria-label-year-selection="@AriaLabelYearSelection"
                enable-top-layer="@(EnableTopLayer ? "true" : null)"
                locale="@Locale"
                i18n-done="@I18nDone"
                week-start-index="@WeekStartIndex"
                show-week-numbers="@(ShowWeekNumbers ? "true" : null)"
                style="@Style"
                class="@Class">
</ix-date-picker>
