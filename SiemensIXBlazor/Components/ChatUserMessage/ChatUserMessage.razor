@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-chat-user-message @attributes="UserAttributes" class="@Class" style="@Style" message="@Message">
    @ChildContent
    @if (Actions is not null)
    {
        <div slot="actions">@Actions</div>
    }
    @if (Attachments is not null)
    {
        <div slot="attachments">@Attachments</div>
    }
</ix-chat-user-message>
