@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-chat @attributes="UserAttributes" class="@Class" style="@Style">
    @ChildContent
    @if (Prompt is not null)
    {
        <div slot="prompt">@Prompt</div>
    }
</ix-chat>
