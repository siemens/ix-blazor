@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-tab-item id="@EffectiveId"
             @attributes="UserAttributes"
             class="@Class"
             style="@Style"
             tab-key="@TabKey"
             disabled="@(Disabled ? "true" : null)"
             selected="@(Selected ? "true" : null)"
             icon="@Icon"
             counter="@Counter"
             closable="@(Closable ? "true" : null)"
             label="@Label"
             aria-label-close-button="@AriaLabelCloseButton">
    @ChildContent
</ix-tab-item>
