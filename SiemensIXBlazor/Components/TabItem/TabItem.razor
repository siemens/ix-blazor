<ix-tab-item id="@Id"
             tab-key="@TabKey"
             label="@Label"
             class="@Class"
             style="@Style"
             icon="@Icon"
             disabled="@Disabled"
             selected="@Selected"
             counter="@Counter"
             closable="@Closable"
             aria-label-close-button="@AriaLabelCloseButton"
             @attributes="UserAttributes">
    @ChildContent
</ix-tab-item>
