@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-tab-item id="@EffectiveId"
             @attributes="UserAttributes"
             class="@Class"
             style="@Style"
             tab-key="@TabKey"
             disabled="@Disabled"
             selected="@Selected"
             icon="@Icon"
             counter="@Counter"
             closable="@Closable"
             label="@Label"
             aria-label-close-button="@AriaLabelCloseButton">
    @ChildContent
</ix-tab-item>
