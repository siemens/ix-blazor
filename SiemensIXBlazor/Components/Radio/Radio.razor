@using Microsoft.JSInterop;
@using SiemensIXBlazor.Components
@inherits IXBaseComponent
@inject IJSRuntime JSRuntime

<ix-radio id="@Id"
          checked="@(Checked ? "true" : null)"
          disabled="@(Disabled ? "true" : null)"
          label="@Label"
          name="@Name"
          required="@(Required ? "true" : null)"
          value="@Value"
          class="@CssClass">
</ix-radio>