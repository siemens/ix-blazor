@using Microsoft.JSInterop;
@using SiemensIXBlazor.Enums.Tooltip;
@using SiemensIXBlazor.Helpers;
@namespace SiemensIXBlazor.Components
@inject IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-tooltip @attributes="UserAttributes"
             id="@Id"
             placement="@(EnumParser<TooltipVariant>.EnumToString(Placement))"
             title-content="@TitleContent"
             interactive="@(Interactive ? "true" : null)"
             for="@(For as string)"
             style="@Style"
             class="@Class">
    @if (TitleIconContent is not null)
    {
        <span slot="title-icon">@TitleIconContent</span>
    }
    @if (TitleContentSlot is not null)
    {
        <span slot="title-content">@TitleContentSlot</span>
    }
    @ChildContent
</ix-tooltip>
