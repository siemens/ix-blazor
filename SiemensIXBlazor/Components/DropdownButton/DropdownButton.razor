@namespace SiemensIXBlazor.Components
@using SiemensIXBlazor.Enums.Button;
@using SiemensIXBlazor.Enums.DropdownButton;
@using SiemensIXBlazor.Helpers;
@inherits IXBaseComponent

<ix-dropdown-button @attributes="UserAttributes" 
                    id="@ElementId"
                    label="@Label"
                    aria-label-dropdown-button="@AriaLabelDropdownButton"
                    variant="@(EnumParser<ButtonVariant>.EnumToString(Variant, replaceUnderscores: true))"
                    placement="@(Placement.HasValue ? EnumParser<DropdownButtonPlacement>.EnumToString(Placement.Value, replaceUnderscores: true): string.Empty )"
                    icon="@Icon" 
                    close-behavior="@(CloseBehavior is bool ? null : CloseBehaviorAttribute)"
                    disabled="@(Disabled ? "true" : null)"
                    enable-top-layer="@(EnableTopLayer ? "true" : null)"
                    focus-checked-item="@(FocusCheckedItem ? "true" : null)"
                    style="@Style" 
                    class="@Class">
    @if (ButtonLabelContent is not null)
    {
        <span slot="button-label">@ButtonLabelContent</span>
    }
    @ChildContent
</ix-dropdown-button>
