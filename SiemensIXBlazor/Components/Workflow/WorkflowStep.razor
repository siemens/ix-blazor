@namespace SiemensIXBlazor.Components
@using SiemensIXBlazor.Enums.Workflow;
@using SiemensIXBlazor.Helpers;
@inherits IXBaseComponent

<ix-workflow-step @attributes="UserAttributes" style="@Style" class="@Class"
    status="@(EnumParser<WorkflowStatus>.EnumToString(Status))" clickable="@(Clickable ? "true" : null)" disabled="@(Disabled ? "true" : null)"
    position="@(EnumParser<WorkflowPosition>.EnumToString(Position))" selected="@(Selected ? "true" : null)" vertical="@(Vertical ? "true" : null)">
    @if (CustomIcon != null)
    {
        <div slot="custom-icon">
            @CustomIcon
        </div>
    }
    @ChildContent
</ix-workflow-step>
