@using Microsoft.JSInterop;
@using SiemensIXBlazor.Components
@using SiemensIXBlazor.Enums.Checkbox
@using SiemensIXBlazor.Helpers
@inherits IXBaseComponent
@inject IJSRuntime JSRuntime
@namespace SiemensIXBlazor.Components.Checkbox

<ix-checkbox-group @attributes="UserAttributes"
                   class="@Class"
                   style="@Style"
                   id="@Id"
                   label="@Label"
                   info-text="@InfoText"
                   warning-text="@WarningText"
                   invalid-text="@InvalidText"
                   valid-text="@ValidText"
                   helper-text="@HelperText"
                   direction="@(EnumParser<CheckboxGroupDirection>.EnumToString(Direction))"
                   show-text-as-tooltip="@(ShowTextAsTooltip ? "true" : null)">
    @ChildContent
</ix-checkbox-group>
