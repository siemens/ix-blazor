@using Microsoft.JSInterop
@using SiemensIXBlazor.Enums.Button
@using SiemensIXBlazor.Helpers
@namespace SiemensIXBlazor.Components
@inject IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-date-dropdown @attributes="UserAttributes"
                  style="@Style"
                  class="@Class"
                  id="@Id"
                  date-range-id="@DateRangeId"
                  format="@Format"
                  from="@From"
                  i18n-done="@I18nDone"
                  i18n-no-range="@I18nNoRange"
                  max-date="@MaxDate"
                  min-date="@MinDate"
                  single-selection="@(SingleSelection ? "true" : null)"
                  to="@To"
                  week-start-index="@WeekStartIndex"
                  locale="@Locale"
                  disabled="@(Disabled ? "true" : null)"
                  enable-top-layer="@(EnableTopLayer ? "true" : null)"
                  show-week-numbers="@(ShowWeekNumbers ? "true" : null)"
                  loading="@(Loading ? "true" : null)"
                  variant="@(EnumParser<ButtonVariant>.EnumToString(Variant, replaceUnderscores: true))">
</ix-date-dropdown>
