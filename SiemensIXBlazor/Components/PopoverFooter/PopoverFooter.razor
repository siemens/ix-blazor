@using SiemensIXBlazor.Enums.Popover
@using SiemensIXBlazor.Helpers
@inherits IXBaseComponent
@namespace SiemensIXBlazor.Components

<ix-popover-footer @attributes="UserAttributes"
                   id="@Id"
                   alignment="@(EnumParser<PopoverFooterAlignment>.EnumToString(Alignment))"
                   class="@Class"
                   style="@Style">
    @if (StartContent != null)
    {
        <div slot="start">@StartContent</div>
    }
    @ChildContent
</ix-popover-footer>
