@using Microsoft.JSInterop;
@inject IJSRuntime JSRuntime
@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-group 
          @attributes="UserAttributes"
          header="@Header"
          style="@Style"
          class="@Class"
          sub-header="@SubHeader"
          expanded="@(Expanded ? "true" : null)"
          expand-on-header-click="@(ExpandOnHeaderClick ? "true" : null)"
          index="@Index"
          selected="@(Selected == true ? "true" : null)"
          suppress-header-selection="@(SuppressHeaderSelection ? "true" : null)"
          id="@Id">
    @if (HeaderContent is not null)
    {
        <div slot="header">@HeaderContent</div>
    }
    @ChildContent
    @if (FooterContent is not null)
    {
        <div slot="footer">@FooterContent</div>
    }
</ix-group>
