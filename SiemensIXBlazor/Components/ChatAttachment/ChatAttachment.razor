@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-chat-attachment @attributes="UserAttributes"
                    id="@ElementId"
                    class="@Class"
                    style="@Style"
                    file-name="@FileName"
                    status="@StatusAttribute"
                    icon="@Icon"
                    hide-remove-button="@(HideRemoveButton ? "true" : null)"
                    preview-supported="@(PreviewSupported ? "true" : null)"
                    remove-aria-label="@RemoveAriaLabel">
</ix-chat-attachment>
