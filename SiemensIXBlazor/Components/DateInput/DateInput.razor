@using SiemensIXBlazor.Enums.Input
@using SiemensIXBlazor.Helpers
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-date-input @attributes="UserAttributes"
               class="@Class"
               style="@Style"
               id="@Id"
               name="@Name"
               placeholder="@Placeholder"
               value="@Value"
               min-date="@MinDate"
               max-date="@MaxDate"
               locale="@Locale"
               format="@Format"
               required="@(Required == true ? "true" : null)"
               helper-text="@HelperText"
               label="@Label"
               aria-label-calendar-button="@AriaLabelCalendarButton"
               invalid-text="@InvalidText"
               readonly="@(Readonly ? "true" : null)"
               disabled="@(Disabled ? "true" : null)"
               info-text="@InfoText"
               warning-text="@WarningText"
               valid-text="@ValidText"
               show-text-as-tooltip="@(ShowTextAsTooltip == true ? "true" : null)"
               i18n-error-date-unparsable="@I18nErrorDateUnparsable"
               show-week-numbers="@(ShowWeekNumbers ? "true" : null)"
               week-start-index="@WeekStartIndex"
               aria-label-previous-month-button="@AriaLabelPreviousMonthButton"
               aria-label-next-month-button="@AriaLabelNextMonthButton"
               suppress-submit-on-enter="@(SuppressSubmitOnEnter ? "true" : null)"
               text-alignment="@(EnumParser<InputTextAlignment>.EnumToString(TextAlignment))"
               enable-top-layer="@(EnableTopLayer ? "true" : null)">
    @if (StartSlot != null)
    {
        <div slot="start">@StartSlot</div>
    }
    @if (EndSlot != null)
    {
        <div slot="end">@EndSlot</div>
    }
</ix-date-input>
