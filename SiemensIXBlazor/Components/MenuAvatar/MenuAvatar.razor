@using Microsoft.JSInterop;
@inject IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-menu-avatar
            @attributes="UserAttributes"
            class="@Class"
            style="@Style"
            slot="ix-menu-avatar"
            id="@Id"
            bottom="@Bottom"
            i18n-logout="@I18nLogout"
            image="@Image"
            initials="@Initials"
            top="@Top"
            tooltip-text="@TooltipText"
            aria-label-tooltip="@AriaLabelTooltip"
            hide-logout-button="@(HideLogoutButton ? "true" : null)"
            enable-top-layer="@(EnableTopLayer ? "true" : null)">
    @ChildContent
</ix-menu-avatar>
