@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-menu-settings @attributes="UserAttributes"
               class="@Class"
               style="@Style"
               slot="ix-menu-settings"
               active-tab-key="@ActiveTabKey"
               aria-label-close-button="@AriaLabelCloseButton"
               label="@Label"
               id="@Id"
               suppress-legacy-tabs="@(SuppressLegacyTabs ? "true" : null)">
    @ChildContent
</ix-menu-settings>
