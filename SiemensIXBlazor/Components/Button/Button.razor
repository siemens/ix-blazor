@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent
@using SiemensIXBlazor.Enums.Button;
@using SiemensIXBlazor.Helpers

<ix-button @onclick="Clicked" 
           @attributes="UserAttributes" 
           style="@Style" 
           class="@Class" 
           id="@Id" 
           disabled="@Disabled"
           icon="@Icon" 
           icon-right="@IconRight" 
           loading="@Loading"
           type="@(EnumParser<ButtonType>.EnumToString(Type))"
           variant="@(EnumParser<ButtonVariant>.EnumToString(Variant, replaceUnderscores: true))"
           form="@Form"
           href="@Href"
           target="@(EnumParser<ButtonTarget>.EnumToString(Target))"
           rel="@Rel">
    @ChildContent
</ix-button>
