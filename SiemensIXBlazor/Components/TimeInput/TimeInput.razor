@using SiemensIXBlazor.Enums.Input
@using SiemensIXBlazor.Helpers
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inherits IXBaseComponent

<ix-time-input @attributes="UserAttributes"
               class="@Class"
               style="@Style"
               id="@Id"
               name="@Name"
               placeholder="@Placeholder"
               value="@Value"
               format="@Format"
               min-time="@MinTime"
               max-time="@MaxTime"
               required="@Required"
               helper-text="@HelperText"
               label="@Label"
               invalid-text="@InvalidText"
               readonly="@Readonly"
               disabled="@Disabled"
               info-text="@InfoText"
               warning-text="@WarningText"
               valid-text="@ValidText"
               show-text-as-tooltip="@ShowTextAsTooltip"
               i18n-error-time-unparsable="@I18nErrorTimeUnparsable"
               hour-interval="@HourInterval"
               minute-interval="@MinuteInterval"
               second-interval="@SecondInterval"
               millisecond-interval="@MillisecondInterval"
               i18n-select-time="@I18nSelectTime"
               i18n-time="@I18nTime"
               i18n-hour-column-header="@I18nHourColumnHeader"
               i18n-minute-column-header="@I18nMinuteColumnHeader"
               i18n-second-column-header="@I18nSecondColumnHeader"
               i18n-millisecond-column-header="@I18nMillisecondColumnHeader"
               suppress-submit-on-enter="@SuppressSubmitOnEnter"
               hide-header="@HideHeader"
               text-alignment="@(EnumParser<InputTextAlignment>.EnumToString(TextAlignment))"
               enable-top-layer="@EnableTopLayer"
               aria-label-time-toggle-button="@AriaLabelTimeToggleButton">
    @if (StartSlot != null)
    {
        <div slot="start">@StartSlot</div>
    }
    @if (EndSlot != null)
    {
        <div slot="end">@EndSlot</div>
    }
</ix-time-input>
