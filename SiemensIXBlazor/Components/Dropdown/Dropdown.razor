@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-dropdown
@attributes="UserAttributes"
id="@Id" 
trigger="@(Trigger as string)"
anchor="@(Anchor as string)"
close-behavior="@(CloseBehavior is bool ? null : CloseBehaviorAttribute)"
header="@Header"
placement="@Placement"
positioning-strategy="@PositioningStrategy"
suppress-automatic-placement="@(SuppressAutomaticPlacement ? "true" : null)"
 suppress-trigger-visibility-check="@(SuppressTriggerVisibilityCheck ? "true" : null)"
 disable-focus-handling="@(DisableFocusHandling ? "true" : null)"
 disable-focus-trap="@(DisableFocusTrap ? "true" : null)"
 enable-top-layer="@(EnableTopLayer ? "true" : null)"
 focus-checked-item="@(FocusCheckedItem ? "true" : null)"
show="@(Show ? "true" : null)"
style="@Style"
class="@Class">
    @ChildContent
</ix-dropdown>
