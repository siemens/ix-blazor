@namespace SiemensIXBlazor.Components

@using SiemensIXBlazor.Helpers
@using SiemensIXBlazor.Enums.Pane

@inherits IXBaseComponent

<ix-pane-layout 
   class="@Class"
   style="@Style"
   @attributes="UserAttributes"
   variant="@(EnumParser<PaneVariant>.EnumToString(Variant))"
   layout="@Layout"
    borderless="@(Borderless ? "true" : null)"
>
    @if (Left is not null)
    {
        <div slot="left">
            @Left
        </div>
    }

    @if (Top is not null)
    {
        <div slot="top">
            @Top
        </div>
    }

    @if (Content is not null)
    {
        <div slot="content">
            @Content
        </div>
    }

    @ChildContent

    @if (Bottom is not null)
    {
        <div slot="bottom">
            @Bottom
        </div>
    }

    @if (Right is not null)
    {
        <div slot="right">
            @Right
        </div>
    }
</ix-pane-layout>
