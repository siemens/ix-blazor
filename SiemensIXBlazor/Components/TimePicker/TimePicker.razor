@using SiemensIXBlazor.Enums.TimePicker
@using SiemensIXBlazor.Helpers
@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-time-picker @attributes="UserAttributes"
                id="@Id"
                class="@Class"
                style="@Style"
                corners="@(EnumParser<TimePickerCorners>.EnumToString(Corners))"
                embedded="@(Embedded ? "true" : null)"
                format="@Format"
                time="@Time"
                min-time="@MinTime"
                max-time="@MaxTime"
                hide-header="@(HideHeader ? "true" : null)"
                hour-interval="@HourInterval"
                minute-interval="@MinuteInterval"
                second-interval="@SecondInterval"
                millisecond-interval="@MillisecondInterval"
                i18n-confirm-time="@I18nConfirmTime"
                i18n-header="@I18nHeader"
                i18n-hour-column-header="@I18nHourColumnHeader"
                i18n-minute-column-header="@I18nMinuteColumnHeader"
                i18n-second-column-header="@I18nSecondColumnHeader"
                i18n-millisecond-column-header="@I18nMillisecondColumnHeader">
</ix-time-picker>
