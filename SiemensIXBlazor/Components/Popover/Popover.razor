@using Microsoft.JSInterop
@using SiemensIXBlazor.Enums.Popover
@using SiemensIXBlazor.Helpers
@inject IJSRuntime JSRuntime
@inherits IXBaseComponent
@namespace SiemensIXBlazor.Components

<ix-popover @attributes="UserAttributes"
            id="@Id"
            trigger="@(Trigger as string)"
            show="@(Show ? "true" : null)"
            placement="@(EnumParser<PopoverPlacement>.EnumToString(Placement))"
            has-spike="@(HasSpike ? "true" : null)"
            trigger-mode="@(EnumParser<PopoverTriggerMode>.EnumToString(TriggerMode))"
            close-on-click-outside="@(CloseOnClickOutside ? "true" : null)"
            class="@Class"
            style="@Style">
    @ChildContent
</ix-popover>
