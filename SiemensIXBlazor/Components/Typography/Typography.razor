@using SiemensIXBlazor.Enums.Typography;
@using SiemensIXBlazor.Helpers;

@namespace SiemensIXBlazor.Components
@inherits IXBaseComponent

<ix-typography @attributes="UserAttributes" id="@Id" style="@Style" class="@Class" bold="@(Bold ? "true" : null)"
	format="@(Format.HasValue ? EnumParser<TypographyFormat>.EnumToString(Format.Value).Replace('_', '-') : null)"
	text-color="@(TextColor.HasValue ? EnumParser<TypographyColor>.EnumToString(TextColor.Value).Replace('_', '-') : null)"
	text-decoration="@(EnumParser<TextDecoration>.EnumToString(TextDecoration).Replace('_', '-'))">
	@ChildContent
</ix-typography>
