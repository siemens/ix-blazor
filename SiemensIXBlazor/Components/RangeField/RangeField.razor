@namespace SiemensIXBlazor.Components.RangeField
@using SiemensIXBlazor.Components
@using SiemensIXBlazor.Enums.RangeField
@inherits IXBaseComponent

<ix-range-field @attributes="UserAttributes"
                class="@Class"
                style="@Style"
                type="@(Type.HasValue ? TypeToString(Type.Value) : null)"
                hide-arrow="@(HideArrow ? "true" : null)">
    @ChildContent
</ix-range-field>

@code {
    private static string TypeToString(RangeFieldType type) => type switch
    {
        RangeFieldType.TimeRange => "time-range",
        RangeFieldType.DateRange => "date-range",
        RangeFieldType.DateTimeRange => "datetime-range",
        _ => throw new ArgumentOutOfRangeException(nameof(type), type, null)
    };
}
